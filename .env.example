APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime maps: pushes live pin/token/fog/chat updates to players. Leave BROADCAST_CONNECTION=log
# to disable realtime. Two Pusher-protocol options are supported (the Echo client handles either):
#   - reverb: set BROADCAST_CONNECTION=reverb and run `php artisan reverb:start` (+ a queue worker).
#   - pusher: set BROADCAST_CONNECTION=pusher for a self-hosted soketi server or Pusher Cloud.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

# Pusher / soketi (used when BROADCAST_CONNECTION=pusher). For a local soketi server use host
# 127.0.0.1, port 6001, scheme http. For Pusher Cloud, set the cluster and leave host blank.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Battle-room voice/video (WebRTC). A public STUN is used by default; set a TURN server for
# reliable connections across strict/symmetric NATs. Voice/video needs Reverb enabled (above)
# and a secure origin (https or localhost, where browsers allow camera/mic).
WEBRTC_STUN_URL="stun:stun.l.google.com:19302"
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public base URL of the bucket, e.g. https://your-bucket.s3.us-east-1.amazonaws.com
AWS_URL=

# Media library disk: "public" (local, default) or "s3" once AWS_* is set.
MEDIA_DISK=public
MEDIA_MAX_SIZE_KB=10240
# CloudFront (or other CDN) base URL in front of the media disk, e.g. https://dxxxx.cloudfront.net
# When set, media URLs are built from this instead of the raw S3/bucket URL.
MEDIA_CDN_URL=

VITE_APP_NAME="${APP_NAME}"
ANTHROPIC_API_KEY=

# Public IPv4 that customers point their custom-domain A record at
CUSTOM_DOMAIN_IP=

# Sentry error reporting — leave the DSN blank to disable (no events are sent when empty).
SENTRY_LARAVEL_DSN=
# Fraction of transactions traced for performance monitoring (0.0 disables, 1.0 = all).
SENTRY_TRACES_SAMPLE_RATE=0.0
# Browser (Vue) error reporting. This DSN is public by design and is exposed to the front-end; use a
# separate Sentry project from the back-end. Leave blank to disable front-end reporting.
SENTRY_BROWSER_DSN=
SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.0
